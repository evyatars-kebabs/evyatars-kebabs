rules_version = '2';
// כללי Firestore של הקבביה של אביתר.
// להדביק ב-Firebase Console -> Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- טבלאות השיאים ----------
    function isBoard(col) {
      return col in ['leaderboard', 'leaderboard_goods', 'leaderboard_shvartz', 'leaderboard_ninja', 'leaderboard_kvk', 'leaderboard_delivery', 'leaderboard_turtles'];
    }
    // רשומה בטבלה: שם, ניקוד, זמן, הסקין שנבחר, יתרת המטבעות (לפרופיל) והצוות באירוע
    function validEntry(d) {
      return d.keys().hasAll(['name', 'score'])
        && d.keys().hasOnly(['name', 'score', 'timestamp', 'skin', 'coins', 'team'])
        && d.name is string && d.name.size() <= 20
        && d.score is number && d.score >= 0 && d.score <= 1000000
        && (!('timestamp' in d) || d.timestamp is timestamp)
        && (!('skin' in d) || (d.skin is string && d.skin.size() <= 40))
        && (!('coins' in d) || (d.coins is number && d.coins >= 0 && d.coins <= 100000000))
        && (!('team' in d) || d.team in ['a', 'b']);
    }

    match /{col}/{playerId} {
      allow read: if isBoard(col);
      allow create: if isBoard(col) && validEntry(request.resource.data);
      // עדכון שם / סקין / שיא חדש - הניקוד לא יכול לרדת
      allow update: if isBoard(col) && validEntry(request.resource.data)
                    && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // ---------- שמירת ההתקדמות של חשבון ----------
    // רק בעל החשבון יכול לקרוא ולכתוב את המסמך שלו
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['username', 'data', 'updatedAt'])
                            && request.resource.data.username is string && request.resource.data.username.size() <= 20
                            && request.resource.data.data is map;
      allow delete: if false;
    }

    // ---------- אירוע קהילתי: צבי הנינג'ה ----------
    // מסמך אחד עם מונים: צוות a/b x 6 מצבי משחק, ומספר החברים בכל צוות. כל כתיבה יכולה רק להוסיף 1 למונה אחד
    function tmntKeys() {
      return ['a_delivery', 'a_kvk', 'a_ninja', 'a_shvartz', 'a_catch', 'a_goods', 'a_members', 'a_hits',
              'b_delivery', 'b_kvk', 'b_ninja', 'b_shvartz', 'b_catch', 'b_goods', 'b_members', 'b_hits'];
    }
    // פגיעות בשריונים (אתגר צבי הנינג'ה): נשלחות בסוף משחק, עד 400 בכתיבה אחת
    function tmntHits(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || (request.resource.data.get(k, 0) > resource.data.get(k, 0)
              && request.resource.data.get(k, 0) <= resource.data.get(k, 0) + 400);
    }
    // הצטרפות לצוות (+1 ל-x_members) מותרת רק כשהצוות לא גדול מדי מהשני:
    // ההפרש קטן מ-3, או קטן מ-15% מכל המשתתפים
    function tmntJoinOk(me, other) {
      return request.resource.data.get(me, 0) == resource.data.get(me, 0)
          || (resource.data.get(me, 0) - resource.data.get(other, 0) < 3
              || (resource.data.get(me, 0) - resource.data.get(other, 0)) * 100
                 < 15 * (resource.data.get(me, 0) + resource.data.get(other, 0)));
    }
    function tmntSame(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    match /events/tmnt {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(tmntKeys())
                    && request.resource.data.size() == 1
                    && request.resource.data.values()[0] is int
                    && request.resource.data.values()[0] >= 1 && request.resource.data.values()[0] <= 400;
      allow update: if request.resource.data.keys().hasOnly(tmntKeys())
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && tmntSame('a_delivery') && tmntSame('a_kvk') && tmntSame('a_ninja')
                    && tmntSame('a_shvartz') && tmntSame('a_catch') && tmntSame('a_goods')
                    && tmntSame('b_delivery') && tmntSame('b_kvk') && tmntSame('b_ninja')
                    && tmntSame('b_shvartz') && tmntSame('b_catch') && tmntSame('b_goods')
                    && tmntSame('a_members') && tmntSame('b_members')
                    && tmntHits('a_hits') && tmntHits('b_hits')
                    && tmntJoinOk('a_members', 'b_members') && tmntJoinOk('b_members', 'a_members');
      allow delete: if false;
    }

    // ---------- קודים (להעברת קודי הפיתוח לשרת בהמשך) ----------
    // אפשר לבדוק קוד אחד לפי השם שלו, אבל אי אפשר לקבל רשימה של כל הקודים
    match /codes/{code} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
